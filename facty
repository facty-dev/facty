#!/bin/sh
# facty — the Facty CLI (the primary interface). Thin launcher: the package
# lives in src/facty (standard src layout, root pyproject.toml). Prefers the
# project venv when present AND runnable (created by `make deps`); falls back
# to the system python3 — the engine core + control plane are dependency-free.
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
PY="python3"
if [ -x "$DIR/.venv/bin/python" ] && "$DIR/.venv/bin/python" -c "import sys" >/dev/null 2>&1; then
    PY="$DIR/.venv/bin/python"
fi
PYTHONPATH="$DIR/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m facty "$@"
