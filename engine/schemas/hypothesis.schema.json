{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hypothesis",
  "description": "A candidate explanation: a set of claims that must be provable from the fact base, with a prior and optional structured fields.",
  "type": "object",
  "required": ["id", "statement", "status", "prior", "claims"],
  "properties": {
    "id": { "type": "string" },
    "statement": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "pruned", "confirmed"] },
    "prior": { "type": "number", "minimum": 0, "maximum": 1 },
    "claims": {
      "type": "array",
      "items": { "type": "object", "description": "Fact pattern that must be provable (backward chaining)." }
    },
    "killer": { "type": "string", "enum": ["rival", "acquaintance", "accomplice", "stranger"] },
    "horse_fate": { "type": "string", "enum": ["stolen", "wandered"] },
    "evidenceFor": { "type": "array", "items": { "type": "string" } },
    "evidenceAgainst": { "type": "array", "items": { "type": "string" } },
    "discriminatingTests": { "type": "array", "items": { "type": "string" } }
  }
}
