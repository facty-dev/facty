{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceItem",
  "description": "A classified evidence file: the sensing half's typed view of messy field input.",
  "type": "object",
  "required": ["file", "evidenceClass", "confidence"],
  "properties": {
    "file": { "type": "string" },
    "evidenceClass": { "type": "string", "enum": ["log", "report", "correspondence", "roster", "note", "financial-record", "other"] },
    "summary": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
