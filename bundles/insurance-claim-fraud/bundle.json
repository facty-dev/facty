[
  {
    "@type": "Rule",
    "id": "r-staged-accident",
    "version": "1",
    "pack": "insurance-claim-fraud",
    "when": [
      {
        "@type": "Condition",
        "subject": "police-report",
        "predicate": "hasWitnesses",
        "valueBool": false
      },
      {
        "@type": "Condition",
        "subject": "police-report",
        "predicate": "hasPaintTransfer",
        "valueBool": false
      },
      {
        "@type": "Condition",
        "subject": "witness",
        "predicate": "sawSuspiciousActivity",
        "valueBool": true
      }
    ],
    "then": [
      {
        "@type": "Action",
        "op": "derive",
        "fact": {
          "@type": "FactTemplate",
          "id": "d1",
          "type": "derived",
          "subject": "claim",
          "predicate": "stagedAccidentLikely",
          "valueBool": true,
          "confidence": 0.8
        }
      },
      {
        "@type": "Action",
        "op": "raise",
        "hypotheses": [
          "H1"
        ]
      }
    ]
  },
  {
    "@type": "Rule",
    "id": "r-inflated-estimate",
    "version": "1",
    "pack": "insurance-claim-fraud",
    "when": [
      {
        "@type": "Condition",
        "subject": "repair-estimate",
        "predicate": "hasPaintCorrection",
        "valueBool": true
      }
    ],
    "then": [
      {
        "@type": "Action",
        "op": "derive",
        "fact": {
          "@type": "FactTemplate",
          "id": "d2",
          "type": "derived",
          "subject": "repair-estimate",
          "predicate": "inflatedDamagesLikely",
          "valueBool": true,
          "confidence": 0.75
        }
      },
      {
        "@type": "Action",
        "op": "raise",
        "hypotheses": [
          "H2"
        ]
      }
    ]
  },
  {
    "@type": "Rule",
    "id": "r-inflated-estimate-adjuster-fee",
    "version": "1",
    "pack": "insurance-claim-fraud",
    "when": [
      {
        "@type": "Condition",
        "subject": "repair-estimate",
        "predicate": "hasTotalLossAdjusterFee",
        "valueBool": true
      }
    ],
    "then": [
      {
        "@type": "Action",
        "op": "derive",
        "fact": {
          "@type": "FactTemplate",
          "id": "d2b",
          "type": "derived",
          "subject": "repair-estimate",
          "predicate": "inflatedDamagesLikely",
          "valueBool": true,
          "confidence": 0.75
        }
      },
      {
        "@type": "Action",
        "op": "raise",
        "hypotheses": [
          "H2"
        ]
      }
    ]
  },
  {
    "@type": "Rule",
    "id": "r-repeat-claimant",
    "version": "1",
    "pack": "insurance-claim-fraud",
    "when": [
      {
        "@type": "Condition",
        "subject": "prior-claims",
        "predicate": "priorParkingLotClaims",
        "valueNum": 2
      }
    ],
    "then": [
      {
        "@type": "Action",
        "op": "derive",
        "fact": {
          "@type": "FactTemplate",
          "id": "d3",
          "type": "derived",
          "subject": "claimant",
          "predicate": "repeatClaimant",
          "valueBool": true,
          "confidence": 0.7
        }
      },
      {
        "@type": "Action",
        "op": "raise",
        "hypotheses": [
          "H1",
          "H2"
        ]
      }
    ]
  },
  {
    "@type": "Rule",
    "id": "r-hit-and-run-no-evidence",
    "version": "1",
    "pack": "insurance-claim-fraud",
    "when": [
      {
        "@type": "Condition",
        "subject": "claim",
        "predicate": "incidentType",
        "valueString": "hit-and-run-parked"
      },
      {
        "@type": "Condition",
        "subject": "police-report",
        "predicate": "hasCCTV",
        "valueBool": false
      },
      {
        "@type": "Condition",
        "subject": "police-report",
        "predicate": "hasWitnesses",
        "valueBool": false
      }
    ],
    "then": [
      {
        "@type": "Action",
        "op": "derive",
        "fact": {
          "@type": "FactTemplate",
          "id": "d4",
          "type": "derived",
          "subject": "claim",
          "predicate": "uncorroboratedHitAndRun",
          "valueBool": true,
          "confidence": 0.6
        }
      },
      {
        "@type": "Action",
        "op": "raise",
        "hypotheses": [
          "H1",
          "H2",
          "H3",
          "H4"
        ]
      }
    ]
  },
  {
    "@type": "Hypothesis",
    "id": "H1",
    "statement": "The accident was staged \u2014 the collision was deliberately caused or fabricated, not a genuine hit-and-run.",
    "status": "open",
    "prior": 0.25,
    "claims": [
      {
        "@type": "Condition",
        "subject": "police-report",
        "predicate": "hasWitnesses",
        "valueBool": false
      },
      {
        "@type": "Condition",
        "subject": "police-report",
        "predicate": "hasPaintTransfer",
        "valueBool": false
      },
      {
        "@type": "Condition",
        "subject": "witness",
        "predicate": "sawSuspiciousActivity",
        "valueBool": true
      }
    ],
    "evidenceFor": [
      "No witnesses and no paint transfer on the vehicle",
      "Witness saw a person loitering near the car, no other vehicle",
      "Hit-and-run claim with no corroborating physical evidence"
    ],
    "evidenceAgainst": [
      "Police report corroborates a parking-lot collision damage pattern",
      "CCTV or independent witness confirms another vehicle made contact"
    ],
    "discriminatingTests": [
      "Is there paint transfer or foreign material on the damaged panel?",
      "Does any independent witness or CCTV show another vehicle striking the car?"
    ]
  },
  {
    "@type": "Hypothesis",
    "id": "H2",
    "statement": "The repair estimate is inflated \u2014 it contains padded, unnecessary, or overpriced line items.",
    "status": "open",
    "prior": 0.3,
    "claims": [
      {
        "@type": "Condition",
        "subject": "repair-estimate",
        "predicate": "hasPaintCorrection",
        "valueBool": true
      }
    ],
    "evidenceFor": [
      "Estimate includes 'paint correction' for scratches unrelated to the reported bumper damage",
      "Estimate includes a 'total loss adjuster fee' on a repairable vehicle",
      "Estimated total is far above market rate for the described damage"
    ],
    "evidenceAgainst": [
      "Independent second-shop estimate is comparable",
      "Every line item maps to damage documented in the police report or photos"
    ],
    "discriminatingTests": [
      "Does an independent appraiser's estimate come in materially lower?",
      "Do the flagged line items correspond to damage visible in the evidence photos?"
    ]
  },
  {
    "@type": "Hypothesis",
    "id": "H3",
    "statement": "The claimed damage is pre-existing \u2014 part of the estimate covers damage that predates the accident.",
    "status": "open",
    "prior": 0.2,
    "claims": [
      {
        "@type": "Condition",
        "subject": "repair-estimate",
        "predicate": "hasPaintCorrection",
        "valueBool": true
      }
    ],
    "evidenceFor": [
      "'Paint correction (minor scratches, passenger door)' is unrelated to a rear-bumper hit-and-run",
      "Prior photos or claim history show the same scratches before the incident date"
    ],
    "evidenceAgainst": [
      "Photos timestamped before the incident show no such damage",
      "Damage pattern is fully consistent with the reported collision"
    ],
    "discriminatingTests": [
      "Do pre-incident photos or prior claim records show the passenger-door scratches?",
      "Is the rust/wear pattern on the flagged damage older than the incident date?"
    ]
  },
  {
    "@type": "Hypothesis",
    "id": "H4",
    "statement": "The claim is legitimate \u2014 a genuine accident with an honest estimate.",
    "status": "open",
    "prior": 0.5,
    "claims": [
      {
        "@type": "Condition",
        "subject": "police-report",
        "predicate": "hasWitnesses",
        "valueBool": true
      }
    ],
    "evidenceFor": [
      "Police report corroborates the claimant's account",
      "No prior claims of the same type; clean history",
      "Estimate line items all map to documented damage at market rates"
    ],
    "evidenceAgainst": [
      "No witnesses, no paint transfer, no CCTV",
      "Estimate contains items unrelated to the reported damage",
      "Claimant has multiple prior claims of the same type"
    ],
    "discriminatingTests": [
      "Does the police report independently corroborate the claimant's version?",
      "Is the claimant's history free of similar prior claims?"
    ]
  },
  {
    "@type": "Constraint",
    "id": "c-police-report-corroborates",
    "type": "eliminate",
    "hypothesis": "H1",
    "when": [
      {
        "@type": "Condition",
        "subject": "police-report",
        "predicate": "hasPaintTransfer",
        "valueBool": true
      }
    ],
    "reason": "Paint transfer from another vehicle corroborates a genuine collision, eliminating a staged accident."
  },
  {
    "@type": "Constraint",
    "id": "c-witness-confirms-other-vehicle",
    "type": "eliminate",
    "hypothesis": "H1",
    "when": [
      {
        "@type": "Condition",
        "subject": "witness",
        "predicate": "sawOtherVehicle",
        "valueBool": true
      }
    ],
    "reason": "An independent witness seeing the other vehicle corroborates the hit-and-run account."
  },
  {
    "@type": "Constraint",
    "id": "c-independent-estimate-comparable",
    "type": "eliminate",
    "hypothesis": "H2",
    "when": [
      {
        "@type": "Condition",
        "subject": "repair-estimate",
        "predicate": "independentEstimateComparable",
        "valueBool": true
      }
    ],
    "reason": "A second shop's estimate is comparable, so the estimate is not inflated."
  },
  {
    "@type": "Constraint",
    "id": "c-pre-incident-photos-clean",
    "type": "eliminate",
    "hypothesis": "H3",
    "when": [
      {
        "@type": "Condition",
        "subject": "vehicle",
        "predicate": "preIncidentPhotosShowNoDamage",
        "valueBool": true
      }
    ],
    "reason": "Photos taken before the incident show none of the claimed damage, so it cannot be pre-existing."
  },
  {
    "@type": "Constraint",
    "id": "c-clean-history-supports-legitimate",
    "type": "support",
    "hypothesis": "H4",
    "when": [
      {
        "@type": "Condition",
        "subject": "prior-claims",
        "predicate": "claimCount",
        "valueNum": 0
      }
    ],
    "reason": "No prior claims at all supports the legitimate-claim hypothesis.",
    "field": "prior",
    "valueNum": 0.8
  },
  {
    "@type": "Constraint",
    "id": "c-police-report-matches-supports-legitimate",
    "type": "support",
    "hypothesis": "H4",
    "when": [
      {
        "@type": "Condition",
        "subject": "police-report",
        "predicate": "corroboratesClaimant",
        "valueBool": true
      }
    ],
    "reason": "The police report independently corroborates the claimant's account.",
    "field": "prior",
    "valueNum": 0.75
  },
  {
    "@type": "Constraint",
    "id": "c-repeat-parking-lot-claims-undercuts-legitimate",
    "type": "eliminate",
    "hypothesis": "H4",
    "when": [
      {
        "@type": "Condition",
        "subject": "prior-claims",
        "predicate": "priorParkingLotClaims",
        "var": "p"
      }
    ],
    "reason": "Repeated prior parking-lot claims are a strong fraud pattern; the legitimate explanation is pruned when the repeat pattern is present."
  }
]