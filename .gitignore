# Environment files (secrets)
.env
.env.local
.env.*.local

# IDE
.vscode/settings.local.json
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.swp
*~

# Agent runtime state — local dev artifact, not version controlled
# (audit trail, message queues, session state, the LLM response cache)
.agentic/
.gondolin-pi/
.firecrawl

# The vendored gondolin VM image — the built snapshot is a build artifact
gondolin/snapshots/

# Python (uv) — the optional DX layer venv (make deps)
.venv/

# Python bytecode (engine runs create these)
__pycache__/
*.pyc

# cleanroom local state
.cache/

# setuptools build artifacts (uv sync)
*.egg-info/

# Facty local data dir (content-addressed store, keys override) — never commit
.facty/
